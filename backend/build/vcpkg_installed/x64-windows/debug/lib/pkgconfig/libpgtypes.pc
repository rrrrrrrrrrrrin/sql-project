prefix=${pcfiledir}/../..
includedir=${prefix}/../include
libdir=${prefix}/lib

Name: libpgtypes
Description: PostgreSQL libpgtypes library
URL: https://www.postgresql.org/
Version: 18.4
Requires.private: zlib, liblz4, openssl
Libs: "-L${libdir}" -llibpgtypes
Libs.private: -lws2_32 "-L${libdir}" -llibpgport_shlib -llibpgcommon_shlib
Cflags: "-I${includedir}"

