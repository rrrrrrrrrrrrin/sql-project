prefix=${pcfiledir}/../..
includedir=${prefix}/../include
libdir=${prefix}/lib

Name: libecpg_compat
Description: PostgreSQL libecpg_compat library
URL: https://www.postgresql.org/
Version: 18.4
Requires.private: zlib, liblz4, openssl, libecpg, libpgtypes
Libs: "-L${libdir}" -llibecpg_compat
Libs.private: -lws2_32 "-L${libdir}" -llibpgport_shlib -llibpgcommon_shlib
Cflags: "-I${includedir}"

