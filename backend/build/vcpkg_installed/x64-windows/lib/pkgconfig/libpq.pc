prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libpq
Description: PostgreSQL libpq library
URL: https://www.postgresql.org/
Version: 18.4
Requires.private: zlib, liblz4, openssl
Libs: "-L${libdir}" -llibpq
Libs.private: -lsecur32 -lws2_32 "-L${libdir}" -llibpgport_shlib -llibpgcommon_shlib
Cflags: "-I${includedir}"

